---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const modules = [
  { id: "lead-management", title: "Lead Management", desc: "Captures, qualifies, and assigns incoming enquiries before they go cold.", standards: "" },
  { id: "sales-pipeline", title: "Opportunity & Sales Pipeline", desc: "Tracks deals through defined stages with pipeline visibility for management.", standards: "" },
  { id: "contact-account", title: "Contact & Account Management", desc: "360° view of every customer — contacts, history, transactions, and documents.", standards: "" },
  { id: "marketing-automation", title: "Marketing Automation", desc: "Plans, executes, and measures campaigns across email, SMS, and WhatsApp.", standards: "GDPR principles" },
  { id: "helpdesk", title: "Customer Service & Helpdesk", desc: "Manages after-sale support and complaint resolution through a structured ticketing system.", standards: "ISO 10002" },
  { id: "quotation-management", title: "Quotation & Proposal Management", desc: "Generates branded quotes pulling from product catalogue and pricing.", standards: "" },
  { id: "crm-analytics", title: "CRM Analytics & Reporting", desc: "Sales intelligence dashboards covering pipeline, performance, and customer value.", standards: "" },
  { id: "loyalty-retention", title: "Loyalty & Retention", desc: "Manages loyalty programmes, customer tiers, and win-back campaigns.", standards: "" }
];
---

<Layout 
	title="Customer Relationship Management (CRM) | Pindah Private Limited"
	description="Lead-to-loyalty customer lifecycle — sales pipeline, marketing automation, and after-sale service. WhatsApp-first communication for the Zimbabwe market."
>
	<HeroBand
		kicker="Vertical 02"
		title="Customer Relationship Management"
		lead="Centralise all customer interactions and provide your sales team with a structured system to convert prospects into revenue."
		primaryCtaText="Request CRM Demo"
		primaryCtaHref="/contact"
		secondaryCtaText="View Modules"
		secondaryCtaHref="#modules"
		imageSrc="https://images.unsplash.com/photo-1552581234-261207845074?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Business team collaborating on customer strategy"
		asideTitle="WhatsApp First"
		asideText="Our CRM features native WhatsApp Business API integration for real-time customer engagement in the regional market."
	/>

	<hr />

	<section id="modules">
		<h2>CRM Modules</h2>
		<div class="grid">
			{modules.map(module => (
				<div style="border: 1px solid var(--border-color); padding: 20px; background: var(--grey-bg);">
					<h3>{module.title}</h3>
					<p style="font-size: 13px; color: #666; min-height: 4.5em;">{module.desc}</p>
					{module.standards && <p style="font-size: 11px; color: var(--link-color); font-weight: 600;">{module.standards}</p>}
					<a href={`/crm/${module.id}`} style="font-size: 12px; font-weight: 600; text-transform: uppercase;">View Module Details ></a>
				</div>
			))}
		</div>
	</section>

	<section style="background: #f2f2f2; padding: 40px; margin-top: 40px;">
		<h2>Case Study: Old Mutual Zimbabwe</h2>
		<p>Old Mutual Zimbabwe deployed our CRM architecture to manage advisor-client relationships across 15 branches. Automated follow-ups and WhatsApp integration lifted policy renewal rates significantly.</p>
		<a href="/contact" class="button">Discuss CRM Integration</a>
	</section>
</Layout>
