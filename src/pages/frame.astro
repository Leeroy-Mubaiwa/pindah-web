---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const moduleLinks = [
  { id: "admissions", title: "Admissions & Enrolment" },
  { id: "attendance", title: "Attendance Management" },
  { id: "grades-assessment", title: "Grades & Assessment" },
  { id: "timetabling", title: "Timetabling" },
  { id: "fee-management", title: "Fee Management" },
  { id: "library", title: "Library Management (PindahLibra)" },
  { id: "staff-payroll", title: "Staff & Payroll" },
  { id: "parent-portal", title: "Parent & Student Portal" },
  { id: "examinations", title: "Examinations" },
  { id: "hostel-boarding", title: "Hostel & Boarding" }
];
---

<Layout 
	title="School Management System (SMS) | Frame by Pindah"
	description="Transform your K-12 institution with Frame. admissions, academics, fees, staff, and parent engagement in a unified system. Optimized for Zimbabwe schools."
>
	<HeroBand
		kicker="Vertical 03"
		title="School Management System (SMS)"
		lead="Comprehensive school administration for admissions, academics, fees, staff, and parent engagement."
		primaryCtaText="Request Frame Trial"
		primaryCtaHref="/contact"
		secondaryCtaText="View Industries"
		secondaryCtaHref="/industries"
		imageSrc="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Students in classroom learning environment"
		asideTitle="Frame by Pindah"
		asideText="Our flagship EdTech solution supports over 5,000 K-12 schools in Zimbabwe with localized workflows for ZIMSEC subjects, dual-currency fees, and WhatsApp parent communication."
	/>

	<hr />

	<section>
		<h2>School Management Software for K-12 Institutions</h2>
		<p>Frame is built for school leaders who need reliable visibility across academics, attendance, fees, communication, and administration. The platform helps schools transition from fragmented records to a single digital operating system.</p>
		<p>In Zimbabwe and broader African contexts, Frame supports practical realities such as ZIMSEC grading structures, dual-currency fee operations, and parent communication through mobile-first channels.</p>
	</section>

	<section>
		<h2>Academic and Administrative Coverage</h2>
		<h3>Student Lifecycle</h3>
		<p>From admissions to progression, Frame centralizes student records, class assignment, and historical academic data to support consistent administration.</p>
		<h3>Teaching and Performance</h3>
		<p>Teachers capture attendance and marks inside structured workflows, enabling timely reporting and easier intervention for at-risk students.</p>
		<h3>Finance and Parent Engagement</h3>
		<p>Fee billing, payment tracking, and parent communication features reduce administrative overhead while improving transparency for guardians.</p>
	</section>

	<section>
		<h2>Frame Module Directory</h2>
		<p>Open a module page to review detailed workflows and deployment scope:</p>
		<ul>
			{moduleLinks.map((module) => (
				<li><a href={`/frame/${module.id}`}>{module.title}</a></li>
			))}
		</ul>
	</section>

	<section>
		<h2>Implementation and School Readiness</h2>
		<p>Rollouts typically start with student and staff data migration, grading and timetable setup, then phased activation of communication and finance features. This approach keeps teaching operations stable during transition.</p>
		<p>Schools usually see improved reporting speed, better attendance follow-up, and higher parent engagement within early terms after go-live.</p>
		<a href="/contact" class="button">Request Frame Trial</a>
	</section>
</Layout>
