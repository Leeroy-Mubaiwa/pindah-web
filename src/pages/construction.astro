---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const modules = [
  { title: "Tendering & Bid Management", desc: "Bid pipeline control from opportunity registration to submission tracking." },
  { title: "Contract Management", desc: "Contract setup, variation management, and correspondence lifecycle logging." },
  { title: "Project Planning & Scheduling", desc: "WBS, critical path planning, and progress tracking across project phases." },
  { title: "Site Management", desc: "Daily diaries, RFIs, instructions, inspections, and material records on site." },
  { title: "Cost Control & Job Costing", desc: "Budget vs committed vs actual vs forecast with earned value visibility." },
  { title: "Progress Billing & Valuations", desc: "Monthly valuation workflows, retention tracking, and final account readiness." }
];
---

<Layout
  title="Construction Management | Pindah Private Limited"
  description="Project tendering, contract management, site execution, progress billing, and cost control for construction operations."
>
  <HeroBand
    kicker="Vertical 11"
    title="Construction Management"
    lead="Project controls from tender to completion with stronger schedule, cost, and compliance visibility."
    primaryCtaText="Discuss Construction Solutions"
    primaryCtaHref="/contact"
    secondaryCtaText="View DMS"
    secondaryCtaHref="/dms"
    imageSrc="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80"
    imageAlt="Construction site with cranes and modern buildings"
    asideTitle="Delivery Discipline"
    asideText="The platform helps teams maintain project momentum through structured planning, field execution records, and auditable billing and contract workflows."
  />

  <hr />

  <section>
    <h2>Construction Management Software for Planning, Cost, and Delivery Control</h2>
    <p>Pindah Construction supports project teams from tendering to close-out with structured controls for scope, schedule, budget, and compliance documentation. It helps organizations reduce project slippage and improve billing confidence.</p>
    <p>The platform is suited to contractors, project owners, and engineering teams needing traceable operational data across the full project lifecycle.</p>
  </section>

  <section>
    <h2>Project Delivery Priorities</h2>
    <h3>Commercial Control</h3>
    <p>Tender, contract, and valuation workflows improve pricing accuracy and reduce disputes during execution.</p>
    <h3>Site Execution Visibility</h3>
    <p>Daily records, RFIs, inspections, and progress updates improve accountability across field and management teams.</p>
    <h3>Cost and Cashflow Discipline</h3>
    <p>Budget, actual, and forecast tracking improves early warning on overruns and helps protect project margins.</p>
  </section>

  <section>
    <h2>Construction Capability Directory</h2>
    <ul>
      {modules.map((module) => (
        <li><strong>{module.title}:</strong> {module.desc}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Implementation Scope</h2>
    <p>Construction implementations typically include project coding standards, document controls, valuation templates, and site team onboarding. This ensures consistent reporting and faster management decisions across active sites.</p>
    <a href="/contact" class="button">Discuss Construction Solutions</a>
  </section>
</Layout>
