---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const partnerTracks = [
  "Referral Partner: introduce qualified opportunities and earn commission on successful activations.",
  "Implementation Partner: lead discovery, configuration, training, and go-live support for client deployments.",
  "Solution Partner: build vertical accelerators and reusable templates on top of Pindah Basa modules."
];

const earningModel = [
  "Implementation fees on deployment work you deliver",
  "Commission on subscribed clients you originate",
  "Renewal and expansion incentives on active accounts",
  "Training and certification support to increase billable capacity"
];
---

<Layout
  title="Pindah Basa Partners | Grow with Pindah"
  description="Join the Pindah Basa Partners Program to implement enterprise solutions and earn commissions through delivery, referrals, and account growth."
>
  <HeroBand
    kicker="Pindah Basa Partners"
    title="Grow with Pindah as a Delivery Partner"
    lead="Join our partner ecosystem to implement Pindah Basa solutions, support digital transformation projects, and earn recurring commissions."
    primaryCtaText="Apply as a Partner"
    primaryCtaHref="/contact"
    secondaryCtaText="View ERP"
    secondaryCtaHref="/erp"
    imageSrc="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80"
    imageAlt="Enterprise partners collaborating on implementation projects"
    asideTitle="Program Intent"
    asideText="The Partners program enables consulting firms, independent implementors, and technology teams to deliver Pindah Basa projects with a clear commercial model."
  />

  <hr />

  <section>
    <h2>Why Join the Partners Program?</h2>
    <p>
      Similar to SAP and Odoo partner ecosystems, Pindah Basa Partners is designed to scale implementation capacity while
      creating shared value. Partners help clients adopt modules correctly, shorten time-to-value, and maintain long-term
      operational performance.
    </p>
  </section>

  <section>
    <h2>Partner Tracks</h2>
    <ul>
      {partnerTracks.map((track) => (
        <li>{track}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>How You Earn</h2>
    <ul>
      {earningModel.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Enablement and Program Structure</h2>
    <h3>Partner Enablement</h3>
    <p>Onboarding includes product walkthroughs, implementation playbooks, and support during your first client rollouts.</p>
    <h3>Co-Selling Support</h3>
    <p>Work with our team on proposals, solution scoping, and demos for larger enterprise opportunities.</p>
    <h3>Delivery Standards</h3>
    <p>Follow structured implementation standards for discovery, setup, migration, training, and post-go-live stabilization.</p>
  </section>

  <section>
    <h2>Start Your Partner Application</h2>
    <p>If you deliver ERP, CRM, logistics, HR, or industry implementation services, apply to become a certified Pindah Basa Partner.</p>
    <a href="/contact" class="button">Apply Now</a>
  </section>
</Layout>
