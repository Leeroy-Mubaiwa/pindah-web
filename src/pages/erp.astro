---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const modules = [
  { id: "gl", title: "General Ledger", desc: "Multi-currency posting, exchange rate management, and financial reconciliation.", standards: "IFRS · SI 104" },
  { id: "accounts-payable", title: "Accounts Payable", desc: "Automates supplier payments, aging analysis, and purchase tracking.", standards: "" },
  { id: "accounts-receivable", title: "Accounts Receivable", desc: "Manages customer invoicing, collections, and automated reminders.", standards: "ZIMRA Fiscalisation" },
  { id: "fixed-assets", title: "Fixed Assets", desc: "Tracks asset lifecycle, depreciation, and disposal logs.", standards: "IAS 16" },
  { id: "inventory", title: "Inventory Management", desc: "Real-time stock tracking across multiple warehouses with FEFO support.", standards: "IAS 2" },
  { id: "procurement", title: "Procurement", desc: "Workflow-based purchase requisitions, POs, and supplier vetting.", standards: "" },
  { id: "project-accounting", title: "Project Accounting", desc: "Tracks project-specific costs, budgets, and revenue recognition.", standards: "IAS 11" },
  { id: "budgeting", title: "Budgeting & Planning", desc: "Collaborative budget creation with actual vs budget monitoring.", standards: "" }
];
---

<Layout 
	title="Pindah ERP | Intelligent Enterprise Resource Planning"
	description="The leading ERP solution for Zimbabwe and the region. localized for ZIMRA compliance and multi-currency operations."
>
	<HeroBand
		kicker="Vertical 01"
		title="Pindah ERP"
		lead="A comprehensive enterprise resource planning suite designed for the complexities of regional finance and operations."
		primaryCtaText="Request ERP Demo"
		primaryCtaHref="/contact"
		secondaryCtaText="View Modules"
		secondaryCtaHref="#modules"
		imageSrc="https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Financial data analysis and enterprise reporting"
		asideTitle="Regional Compliance"
		asideText="Pre-configured for ZIMRA Fiscalisation, ZiG/USD multi-currency reporting, and local VAT statutory requirements."
	/>

	<hr />

	<section id="modules">
		<h2>ERP Modules</h2>
		<div class="grid">
			{modules.map(module => (
				<div style="border: 1px solid var(--border-color); padding: 20px; background: var(--grey-bg);">
					<h3>{module.title}</h3>
					<p style="font-size: 13px; color: #666; min-height: 4.5em;">{module.desc}</p>
					{module.standards && <p style="font-size: 11px; color: var(--link-color); font-weight: 600;">{module.standards}</p>}
					<a href={`/erp/${module.id}`} style="font-size: 12px; font-weight: 600; text-transform: uppercase;">View Module Details ></a>
				</div>
			))}
		</div>
	</section>

	<section style="background: #f2f2f2; padding: 40px; margin-top: 40px;">
		<h2>Case Study: Delta Corporation</h2>
		<p>Delta Corporation utilized our multi-currency reconciliation engine to streamline financial reporting across 12 business units during the ZiG transition period.</p>
		<a href="/contact" class="button">Inquire About ERP</a>
	</section>
</Layout>
