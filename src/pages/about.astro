---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';
---

<Layout 
	title="About Pindah | Our Mission & Values"
	description="Learn about Pindah Private Limited, a Zimbabwe-based enterprise software company transforming African institutions through intelligent, localized technology."
>
	<HeroBand
		kicker="About Pindah"
		title="Transforming Operations through Localization"
		lead="Founded in 2024, Pindah Private Limited is a Zimbabwe-based enterprise software company on a mission to transform how institutions operate through intelligent, localized, and affordable technology."
		primaryCtaText="Contact Us"
		primaryCtaHref="/contact"
		secondaryCtaText="Explore Industries"
		secondaryCtaHref="/industries"
		imageSrc="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Business team collaborating in a modern office"
		asideTitle="Our Position"
		asideText="African institutions have long been underserved by generic global tools. We build software grounded in local workflows, compliance realities, and practical implementation needs."
	/>

	<hr style="border: 0; border-top: 1px solid var(--border-color); margin: 24px 0;" />

	<section class="grid">
		<div>
			<h3>The Pindah Story</h3>
			<p>Pindah was founded in response to a fundamental market reality: African institutions have been systematically underserved by global enterprise software. We bridge the gap with software that understands local workflows, regulatory requirements, and infrastructure challenges.</p>
		</div>
		<div>
			<h3>Our Mission</h3>
			<p>To transform the way schools and enterprises operate by delivering powerful, intuitive software that drives operational efficiency, data-driven decision-making, and community engagement.</p>
		</div>
	</section>

	<section>
		<h2>Our Strategic Pillars</h2>
		<p>We build our competitive advantage on four key foundations:</p>
		<ul>
			<li><strong>Localization:</strong> Deep understanding of African market dynamics, from currency volatility to regulatory nuances.</li>
			<li><strong>Affordability:</strong> Accessible pricing models that empower organizations historically priced out of digital transformation.</li>
			<li><strong>Quality:</strong> Secure, reliable, and high-performance systems that rival global competitors.</li>
			<li><strong>Impact:</strong> Measuring success by the positive economic and social outcomes our clients achieve.</li>
		</ul>
	</section>

	<section style="background: #f2f2f2; padding: 40px; margin-top: 40px;">
		<h3>Headquarters</h3>
		<p>Harare, Zimbabwe</p>
		<h3>Contact Information</h3>
		<p>admin@pindah.org<br/>+263 774 454 447</p>
	</section>
</Layout>
