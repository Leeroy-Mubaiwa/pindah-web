---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const modules = [
  { id: "policy-administration", title: "Policy Administration", desc: "Manages the full lifecycle of insurance policies from inception to renewal.", standards: "" },
  { id: "underwriting", title: "Underwriting", desc: "Assesses risk and determines premium pricing for new and renewed policies.", standards: "" },
  { id: "claims-management", title: "Claims Management", desc: "End-to-end claims processing from FNOL to settlement payment.", standards: "" },
  { id: "reinsurance", title: "Reinsurance", desc: "Manages facultative and treaty reinsurance arrangements.", standards: "IAS 4 · IFRS 17" },
  { id: "premium-collection", title: "Premium Collection", desc: "Manages premium invoicing, payment collection, and reconciliation.", standards: "ZIMRA Fiscalisation" },
  { id: "agency-management", title: "Agency & Broker Management", desc: "Manages brokers, agents, and bancassurance partners.", standards: "IPEC Standards" },
  { id: "insurance-compliance", title: "Regulatory & Compliance", desc: "Generates IPEC-required statutory returns and compliance reports.", standards: "IPEC · IFRS 17" }
];
---

<Layout 
	title="Insurance Management | Pindah Private Limited"
	description="Comprehensive policy administration, underwriting, and claims management. Optimized for Zimbabwe IPEC compliance and multi-currency premiums."
>
	<HeroBand
		kicker="Vertical 05"
		title="Insurance Management"
		lead="End-to-end insurance administration suite designed for risk assessment, claims efficiency, and regulatory compliance."
		primaryCtaText="Request Insurance Demo"
		primaryCtaHref="/contact"
		secondaryCtaText="View Modules"
		secondaryCtaHref="#modules"
		imageSrc="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Insurance policy review and risk management"
		asideTitle="IPEC Compliance"
		asideText="Pre-configured for IPEC statutory returns, IFRS 17 reporting, and automated ZIMRA premium tax computations."
	/>

	<hr />

	<section id="modules">
		<h2>Insurance Modules</h2>
		<div class="grid">
			{modules.map(module => (
				<div style="border: 1px solid var(--border-color); padding: 20px; background: var(--grey-bg);">
					<h3>{module.title}</h3>
					<p style="font-size: 13px; color: #666; min-height: 4.5em;">{module.desc}</p>
					{module.standards && <p style="font-size: 11px; color: var(--link-color); font-weight: 600;">{module.standards}</p>}
					<a href={`/insurance/${module.id}`} style="font-size: 12px; font-weight: 600; text-transform: uppercase;">View Module Details ></a>
				</div>
			))}
		</div>
	</section>

	<section style="background: #f2f2f2; padding: 40px; margin-top: 40px;">
		<h2>Case Study: ZIB Mobile Integration</h2>
		<p>Zimbabwe Insurance Brokers Limited (ZIB) utilized our mobile-first CRM layer to give clients real-time policy views and claims notifications, directly integrated with their core broking systems via REST API.</p>
		<a href="/contact" class="button">Inquire About Insurance Solutions</a>
	</section>
</Layout>
