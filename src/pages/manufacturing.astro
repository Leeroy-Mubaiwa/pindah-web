---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const modules = [
  { id: "bom", title: "Bill of Materials (BOM)", desc: "Defines the exact recipe or formula for every finished product.", standards: "" },
  { id: "planning", title: "Production Planning", desc: "Converts demand into feasible production orders with full material awareness.", standards: "MRP II · APICS" },
  { id: "shop-floor", title: "Shop Floor Control", desc: "Real-time tracking of production execution on the factory floor.", standards: "" },
  { id: "quality-control", title: "Quality Control", desc: "Enforces quality checks at defined inspection points.", standards: "ISO 9001 · GMP" },
  { id: "traceability", title: "Batch & Lot Traceability", desc: "Full forward and backward traceability for regulatory audits.", standards: "MCAZ Regulations" },
  { id: "costing", title: "Product Costing", desc: "Calculates true manufacturing cost and compares standard to actual.", standards: "IAS 2" },
  { id: "maintenance", title: "Machine Maintenance (CMMS)", desc: "Schedules and tracks maintenance on production equipment.", standards: "ISO 55001" },
  { id: "manufacturing-warehouse", title: "Warehouse (Stores)", desc: "Manages raw material stores and finished goods within the factory.", standards: "" }
];
---

<Layout 
	title="Manufacturing Management | Pindah Private Limited"
	description="Comprehensive production planning, shop floor execution, and quality control. Specialized for pharmaceutical and industrial manufacturing in Zimbabwe."
>
	<HeroBand
		kicker="Vertical 04"
		title="Manufacturing Management"
		lead="Drive efficiency from raw material to finished goods with integrated production planning and real-time shop floor execution."
		primaryCtaText="Request Manufacturing Demo"
		primaryCtaHref="/contact"
		secondaryCtaText="View Modules"
		secondaryCtaHref="#modules"
		imageSrc="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Advanced manufacturing facility and quality control"
		asideTitle="Pharmaceutical Ready"
		asideText="Validated systems for MCAZ batch traceability, GMP quality controls, and ISO 9001 compliance."
	/>

	<hr />

	<section id="modules">
		<h2>Manufacturing Modules</h2>
		<div class="grid">
			{modules.map(module => (
				<div style="border: 1px solid var(--border-color); padding: 20px; background: var(--grey-bg);">
					<h3>{module.title}</h3>
					<p style="font-size: 13px; color: #666; min-height: 4.5em;">{module.desc}</p>
					{module.standards && <p style="font-size: 11px; color: var(--link-color); font-weight: 600;">{module.standards}</p>}
					<a href={`/manufacturing/${module.id}`} style="font-size: 12px; font-weight: 600; text-transform: uppercase;">View Module Details ></a>
				</div>
			))}
		</div>
	</section>

	<section style="background: #f2f2f2; padding: 40px; margin-top: 40px;">
		<h2>Case Study: Pharmanova Zimbabwe</h2>
		<p>Pharmanova Zimbabwe utilizes our integrated manufacturing suite covering granulation, quality validation, and regulatory dispatch. MCAZ batch traceability is a core functional requirement driving this implementation.</p>
		<a href="/contact" class="button">Discuss Manufacturing Solutions</a>
	</section>
</Layout>
