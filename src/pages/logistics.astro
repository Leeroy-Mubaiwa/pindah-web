---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const moduleLinks = [
  { id: "delivery-order", title: "Delivery Order Management" },
  { id: "route-optimisation", title: "Route Optimisation" },
  { id: "driver-tracking", title: "Real-Time Driver Tracking" },
  { id: "pod", title: "Proof of Delivery (POD)" },
  { id: "fleet-management", title: "Vehicle Fleet Management" },
  { id: "driver-management", title: "Driver Management" },
  { id: "logistics-analytics", title: "Logistics Analytics" }
];
---

<Layout 
	title="Logistics & Fleet Management | Pindah Private Limited"
	description="Advanced delivery order management, route optimisation, and real-time driver tracking. Optimized for high-density logistics networks in Zimbabwe."
>
	<HeroBand
		kicker="Vertical 07"
		title="Logistics & Fleet Management"
		lead="Delivery order orchestration, route optimization, driver tracking, and proof of delivery for high-density operations."
		primaryCtaText="Optimize your Fleet"
		primaryCtaHref="/contact"
		secondaryCtaText="View Supply Chain"
		secondaryCtaHref="/supply-chain"
		imageSrc="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Warehouse and logistics operations"
		asideTitle="Operational Strength"
		asideText="We coordinate movement from origin to destination with OSRM-based routing, EcoCash driver advance workflows, and resilient real-time tracking even in intermittent network conditions."
	/>

	<hr />

	<section>
		<h2>Logistics Management Software for Fleet, Delivery, and Route Control</h2>
		<p>Pindah Logistics helps operations teams move goods faster with higher delivery reliability and better cost visibility. The platform combines dispatch planning, route logic, mobile tracking, and delivery confirmation into one continuous workflow.</p>
		<p>For local delivery environments, the system supports practical routing options, driver communication, and field data capture designed for variable connectivity and high-density urban distribution.</p>
	</section>

	<section>
		<h2>Operational Outcomes</h2>
		<h3>Dispatch Discipline</h3>
		<p>Teams can standardize delivery order creation, sequencing, and assignment so fewer jobs are delayed or duplicated.</p>
		<h3>Field Visibility</h3>
		<p>Real-time driver tracking and proof-of-delivery records reduce manual follow-up and improve customer communication quality.</p>
		<h3>Fleet Performance</h3>
		<p>Vehicle and driver metrics support better maintenance planning, lower downtime, and stronger on-time delivery performance.</p>
	</section>

	<section>
		<h2>Logistics Module Directory</h2>
		<ul>
			{moduleLinks.map((module) => (
				<li><a href={`/logistics/${module.id}`}>{module.title}</a></li>
			))}
		</ul>
	</section>

	<section>
		<h2>Implementation Scope</h2>
		<p>Deployments typically include route setup, vehicle and driver master data, mobile rollout, and dispatch team training. Integration with ERP sales and inventory workflows can be phased in as operational maturity improves.</p>
		<a href="/contact" class="button">Optimize your Fleet</a>
	</section>
</Layout>
