---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';

const modules = [
  { id: "patient-registration", title: "Patient Registration", desc: "Demographics capture, ID generation, and medical aid verification.", standards: "" },
  { id: "outpatient-opd", title: "Outpatient / OPD", desc: "Appointment scheduling, triage, and SOAP-format consultation notes.", standards: "ICD-10" },
  { id: "inpatient-ward", title: "Inpatient / Ward", desc: "Bed assignment, nursing notes, and discharge documentation.", standards: "" },
  { id: "emr", title: "Electronic Medical Records", desc: "Longitudinal patient health records with clinical document scanning.", standards: "HL7 FHIR" },
  { id: "laboratory", title: "Laboratory (LIS)", desc: "Test order creation, result entry, and reference range checking.", standards: "" },
  { id: "radiology", title: "Radiology (RIS)", desc: "Order registration, study worklists, and PACS integration.", standards: "" },
  { id: "pharmacy-management", title: "Pharmacy Management", desc: "Prescription receiving, dispensing, and FEFO inventory control.", standards: "" },
  { id: "medical-billing", title: "Billing & Medical Aid", desc: "Electronic submission to CIMAS, PSMAS, and Premier societies.", standards: "" },
  { id: "health-reporting", title: "Health Information", desc: "Ministry of Health DHIS2 data reporting and notifiable disease tracking.", standards: "WHO DHIS2" }
];
---

<Layout 
	title="Healthcare Management | Pindah Private Limited"
	description="Comprehensive clinical and administrative operations for hospitals and clinics. Optimized for Zimbabwe Ministry of Health (DHIS2) and Medical Aid billing."
>
	<HeroBand
		kicker="Vertical 09"
		title="Healthcare Management"
		lead="Digitise clinical and administrative operations with our hospital management suite, optimized for national health interoperability."
		primaryCtaText="Request Healthcare Demo"
		primaryCtaHref="/contact"
		secondaryCtaText="View Modules"
		secondaryCtaHref="#modules"
		imageSrc="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Modern medical facility with digital systems"
		asideTitle="DHIS2 Interoperability"
		asideText="Our platform supports automated Ministry of Health DHIS2 data reporting and electronic medical aid claim submission."
	/>

	<hr />

	<section id="modules">
		<h2>Healthcare Modules</h2>
		<div class="grid">
			{modules.map(module => (
				<div style="border: 1px solid var(--border-color); padding: 20px; background: var(--grey-bg);">
					<h3>{module.title}</h3>
					<p style="font-size: 13px; color: #666; min-height: 4.5em;">{module.desc}</p>
					{module.standards && <p style="font-size: 11px; color: var(--link-color); font-weight: 600;">{module.standards}</p>}
					<a href={`/hospital/${module.id}`} style="font-size: 12px; font-weight: 600; text-transform: uppercase;">View Module Details ></a>
				</div>
			))}
		</div>
	</section>

	<section style="background: #f2f2f2; padding: 40px; margin-top: 40px;">
		<h2>Case Study: Harare Central Hospital</h2>
		<p>Harare Central Hospital utilized our LIS module to automate laboratory result delivery, reducing turnaround time for critical diagnostic results by over 40%.</p>
		<a href="/contact" class="button">Inquire About Healthcare</a>
	</section>
</Layout>
