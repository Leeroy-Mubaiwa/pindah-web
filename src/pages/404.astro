---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';
---

<Layout
  title="Page Not Found | Pindah"
  description="The page you requested could not be found. Return to Pindah home or explore key product pages."
>
  <HeroBand
    kicker="404"
    title="Page Not Found"
    lead="The page you are looking for does not exist or may have moved. Use the links below to continue browsing Pindah."
    primaryCtaText="Go to Homepage"
    primaryCtaHref="/"
    secondaryCtaText="Contact Support"
    secondaryCtaHref="/contact"
    imageSrc="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&w=1200&q=80"
    imageAlt="Abstract digital error and recovery concept"
    asideTitle="Need Help?"
    asideText="If this link came from your documentation or bookmarks, contact us and we will help you locate the correct route."
  />

  <section>
    <h2>Quick Navigation</h2>
    <ul>
      <li><a href="/erp">ERP</a></li>
      <li><a href="/crm">CRM</a></li>
      <li><a href="/frame">School Management (SMS)</a></li>
      <li><a href="/logistics">Logistics</a></li>
      <li><a href="/partners">Partners</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </section>
</Layout>
