---
import Layout from '../layouts/Layout.astro';
import HeroBand from '../components/HeroBand.astro';
---

<Layout 
	title="Contact Pindah | Request a Demo"
	description="Get in touch with Pindah Private Limited for inquiries about Frame EdTech or Pindah ERP. Professional enterprise software support in Harare, Zimbabwe."
>
	<HeroBand
		kicker="Contact and demos"
		title="Connect with our Strategic Team"
		lead="Discuss your operational requirements and learn how Pindah can transform your institution's efficiency and visibility."
		primaryCtaText="Send Message"
		primaryCtaHref="mailto:admin@pindah.org"
		secondaryCtaText="View ERP"
		secondaryCtaHref="/erp"
		imageSrc="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80"
		imageAlt="Professional team meeting around a table"
		asideTitle="Response Standard"
		asideText="We prioritize clarity, speed, and practical guidance. Share your context and we will recommend the right modules, rollout approach, and support model."
	/>

	<hr style="border: 0; border-top: 1px solid var(--border-color); margin: 24px 0;" />

	<section class="grid">
		<div>
			<h2>General Inquiries</h2>
			<p>For product information, demos, and strategic consultations.</p>
			<ul style="list-style: none; padding: 0;">
				<li>Email: <a href="mailto:admin@pindah.org">admin@pindah.org</a></li>
				<li>Phone: +263 774 454 447</li>
			</ul>
			
			<h2 style="margin-top: 32px;">Support</h2>
			<p>Dedicated technical support for existing clients using Frame or Pindah ERP.</p>
			<ul style="list-style: none; padding: 0;">
				<li>Email: <a href="mailto:support@pindah.org">support@pindah.org</a></li>
			</ul>
		</div>
		<div>
			<div style="background: #f2f2f2; padding: 40px; border: 1px solid var(--border-color);">
				<h3>Office Location</h3>
				<p>Harare, Zimbabwe</p>
				
				<h3 style="margin-top: 24px;">Working Hours</h3>
				<p>Monday - Friday: 8:00 AM - 5:00 PM (CAT)</p>
				
				<a href="mailto:admin@pindah.org" class="button" style="margin-top: 24px;">Send Message</a>
			</div>
		</div>
	</section>

	<section>
		<h2>Request a Demo</h2>
		<p>Ready to see our platforms in action? Contact us to schedule a comprehensive walkthrough of the modules relevant to your industry.</p>
	</section>
</Layout>
